---
// Aquí irá la lógica de Supabase pronto
---

<html lang="es">
<head>
	<meta charset="utf-8" />
	<title>Gestor de Gastos</title>
	<script src="https://tailwindcss.com"></script>
</head>
<body class="bg-gray-100 min-h-screen flex items-center justify-center p-4">
	<div class="bg-white p-8 rounded-2xl shadow-xl w-full max-w-md">
		<h1 class="text-3xl font-bold text-gray-800 mb-6 text-center">💰 Mis Gastos</h1>

		<div class="space-y-4">
			<input type="text" placeholder="¿En qué gastaste?" class="w-full border p-3 rounded-lg outline-none focus:ring-2 focus:ring-blue-500" />
			<input type="number" placeholder="Monto $" class="w-full border p-3 rounded-lg outline-none focus:ring-2 focus:ring-blue-500" />
			<button class="w-full bg-blue-600 text-white font-bold py-3 rounded-lg hover:bg-blue-700 transition">Guardar Gasto</button>
		</div>

		<div class="mt-8 border-t pt-6">
			<h2 class="text-lg font-semibold text-gray-600 mb-4">Historial reciente</h2>
			<div class="bg-gray-50 p-4 rounded-lg text-gray-500 text-center">
				Todavía no hay gastos anotados.
			</div>
		</div>
	</div>
<script>
  // IMPORTANTE: URL completa para que cargue la librería
  import { createClient } from 'https://jsdelivr.net'

  // 1. Configuración corregida
  const supabaseUrl = 'https://yewvuicfqjyzbkericsb.supabase.co'
  const supabaseKey = 'sb_publishable_9hnbTJXjPw3aS7Dc8f19tA_GCYg1zue'
  const _supabase = createClient(supabaseUrl, supabaseKey)

  // 2. Elementos del HTML
  const btn = document.querySelector('button');
  const inputNombre = document.querySelector('input[type="text"]');
  const inputMonto = document.querySelector('input[type="number"]');
  const listaGastos = document.querySelector('.mt-8 div');

  // 3. Función para mostrar los gastos
  async function cargarGastos() {
    const { data, error } = await _supabase
      .from('gastos')
      .select('*')
      .order('created_at', { ascending: false });

    if (error) {
        console.error("Error cargando:", error);
        return;
    }

    if (data && data.length > 0) {
      listaGastos.innerHTML = data.map(g => `
        <div class="flex justify-between p-2 border-b text-gray-700">
          <span>${g.descripcion}</span>
          <span class="font-bold">$${g.monto}</span>
        </div>
      `).join('');
    }
  }

  // 4. Lógica para GUARDAR
  btn.addEventListener('click', async () => {
    const nombre = inputNombre.value;
    const monto = parseFloat(inputMonto.value);

    if(!nombre || isNaN(monto)) {
        alert("Por favor, completa los campos correctamente");
        return;
    }

    const { error } = await _supabase
      .from('gastos')
      .insert([{ descripcion: nombre, monto: monto }]);

    if (error) {
      alert('Error al guardar: ' + error.message);
    } else {
      inputNombre.value = '';
      inputMonto.value = '';
      cargarGastos(); 
    }
  });

  cargarGastos();
</script>


</body>
</html>