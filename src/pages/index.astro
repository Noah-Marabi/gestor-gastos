---
---

<html lang="es">
<head>
  <meta charset="utf-8" />
  <title>Gestor de Gastos</title>

  <!-- (opcional) comentalo si sigue tirando error -->
  <!-- <script src="https://cdn.tailwindcss.com"></script> -->
</head>

<body class="bg-gray-100 min-h-screen flex items-center justify-center p-4">

  <div class="bg-white p-8 rounded-2xl shadow-xl w-full max-w-md">

    <h1 class="text-3xl font-bold text-gray-800 mb-4 text-center">
      💰 Mis Gastos
    </h1>

    <p id="total" class="text-center text-xl font-bold text-green-600 mb-6">
      Total: $0
    </p>

    <div class="space-y-4">
      <input id="desc" type="text" placeholder="¿En qué gastaste?"
        class="w-full border p-3 rounded-lg" />

      <input id="monto" type="number" placeholder="Monto $"
        class="w-full border p-3 rounded-lg" />

      <select id="categoria" class="w-full border p-3 rounded-lg">
        <option value="comida">🍔 Comida</option>
        <option value="transporte">🚌 Transporte</option>
        <option value="ocio">🎮 Ocio</option>
        <option value="otros">📦 Otros</option>
      </select>

      <button id="btnGuardar"
        class="w-full bg-blue-600 text-white font-bold py-3 rounded-lg">
        Guardar Gasto
      </button>
    </div>

    <div class="mt-8 border-t pt-6">
      <h2 class="text-lg font-semibold text-gray-600 mb-4">
        Historial reciente
      </h2>

      <div id="contenedor-gastos"
        class="bg-gray-50 p-4 rounded-lg text-gray-500 text-center">
        Cargando gastos...
      </div>
    </div>

  </div>

  <!-- 🔥 SCRIPT CORRECTO -->
  <script type="module">
    import { supabase } from '../lib/supabase.js'

    const btn = document.getElementById('btnGuardar');
    const inputNombre = document.getElementById('desc');
    const inputMonto = document.getElementById('monto');
    const listaGastos = document.getElementById('contenedor-gastos');

    async function cargarGastos() {
      const { data, error } = await supabase
        .from('gastos')
        .select('*')
        .order('created_at', { ascending: false });

      console.log("DATA:", data);
      console.log("ERROR:", error);

      if (error) return;

      if (data && data.length > 0) {
        listaGastos.innerHTML = data.map(g => `
          <div class="flex justify-between p-2 border-b">
            <span>${g.descripcion}</span>
            <span>$${g.monto}</span>
          </div>
        `).join('');
      } else {
        listaGastos.innerHTML = 'Todavía no hay gastos.';
      }
    }

    btn.addEventListener('click', async () => {
      console.log("CLICK");

      const nombre = inputNombre.value;
      const monto = parseFloat(inputMonto.value);

      if (!nombre || isNaN(monto)) {
        alert("Completa los datos");
        return;
      }

      const { error } = await supabase
        .from('gastos')
        .insert([{ descripcion: nombre, monto: monto }]);

      console.log("ERROR INSERT:", error);

      if (!error) {
        inputNombre.value = '';
        inputMonto.value = '';
        cargarGastos();
      }
    });

    cargarGastos();
  </script>

</body>
</html>